@page "/"
@page "/dashboard"
@inject AppState S
@inject NavigationManager Nav

@if (S.User != null)
{
    var days = S.LastDays(7);
    var labels = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(i - 6).ToString("ddd")).ToArray();
    var open = S.User.Tasks.Count(t => !t.Done);
    <h1 class="text-[26px]">Welcome back, @S.User.Name! 👋</h1>
    <p class="muted">Let's make today productive!</p>
    <div class="mt-5 grid grid-cols-1 items-start gap-5 md:grid-cols-[1fr_1.2fr_1fr]">
        <div class="flex flex-col gap-4">
            <div class="card">
                <div class="card-head"><span>Today's Progress</span><span class="text-sm text-blue-500">◎</span></div>
                <div class="big">@S.TodayMinutes min</div>
                <ProgressBar Value="S.TodayMinutes" Max="S.User.DailyGoal" />
                <small class="text-[11px] text-muted">Goal: @S.User.DailyGoal min (@(S.TodayMinutes * 100 / S.User.DailyGoal)%)</small>
            </div>
            <div class="card">
                <div class="card-head"><span>Current Streak</span><span class="text-sm text-orange-500">🔥</span></div>
                <div class="big">@S.Streak days</div>
                <small class="text-[11px] text-muted">Keep it going! 🔥</small>
            </div>
            <div class="card">
                <div class="card-head"><span>Total Study Time</span><span class="text-sm text-green-500">◷</span></div>
                <div class="big">@(S.TotalMinutes / 60)h @(S.TotalMinutes % 60)m</div>
                <small class="text-[11px] text-muted">@S.SessionCount sessions completed</small>
            </div>
        </div>
        <div class="card">
            <div class="card-head"><span>7-Day Activity</span></div>
            <p class="muted">Your study time over the last week</p>
            <BarChart Values="days" Labels="labels" />
        </div>
        <div class="flex flex-col gap-4">
            <div class="card">
                <div class="card-head"><span>Achievements</span><span class="text-sm text-yellow-500">🏆</span></div>
                <div class="big">@S.Achievements.Count(a => a.Unlocked)</div>
                <small class="text-[11px] text-muted">Badges unlocked 🏆</small>
            </div>
            <div class="card">
                <div class="card-head"><span>Quick Start</span></div>
                <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("timer")'>▷ Start Study Session</button>
                <button class="btn btn-outline" @onclick='() => Nav.NavigateTo("tasks")'>☑ Tasks (@open open)</button>
                <button class="btn btn-outline" @onclick='() => Nav.NavigateTo("goals")'>◎ Manage Goals</button>
                <button class="btn btn-outline" @onclick='() => Nav.NavigateTo("profile")'>↗ View Full Stats</button>
            </div>
        </div>
    </div>
}
