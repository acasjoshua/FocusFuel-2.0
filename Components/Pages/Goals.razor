@page "/goals"
@inject AppState S

@if (S.User != null)
{
    var weekly = S.User.DailyGoal * 7;
    var monthly = S.User.DailyGoal * DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
    <div class="flex flex-wrap items-start gap-4">
        <div>
            <h1 class="text-[26px]">Study Goals</h1>
            <p class="muted">Track your progress and adjust your targets</p>
        </div>
        @if (editing)
        {
            <div class="flex items-center gap-2">
                <input class="field !w-24" type="number" @bind="newGoal" />
                <button class="btn btn-primary btn-sm" @onclick="Save">Save</button>
            </div>
        }
        else
        {
            <button class="btn btn-primary btn-sm" @onclick="StartEdit">✎ Edit Goals</button>
        }
    </div>
    <div class="my-5 grid grid-cols-1 gap-5 md:grid-cols-[1fr_1.4fr]">
        <div class="flex flex-col gap-4">
            <div class="card">
                <div class="card-head"><span>Daily Goal</span><span class="text-sm text-blue-500">◎</span></div>
                <div class="big">@S.TodayMinutes / @S.User.DailyGoal min</div>
                <ProgressBar Value="S.TodayMinutes" Max="S.User.DailyGoal" />
                <small class="text-[11px] text-muted">@(S.TodayMinutes * 100 / S.User.DailyGoal)% complete</small>
            </div>
            <div class="card">
                <div class="card-head"><span>Weekly Goal</span><span class="text-sm text-green-500">▭</span></div>
                <div class="big">@S.WeekMinutes / @weekly min</div>
                <ProgressBar Value="S.WeekMinutes" Max="weekly" />
                <small class="text-[11px] text-muted">@(S.WeekMinutes * 100 / weekly)% complete</small>
            </div>
            <div class="card">
                <div class="card-head"><span>Monthly Progress</span><span class="text-sm text-purple-500">↗</span></div>
                <div class="big">@S.MonthMinutes / @monthly min</div>
                <ProgressBar Value="S.MonthMinutes" Max="monthly" />
                <small class="text-[11px] text-muted">@(S.MonthMinutes * 100 / monthly)% of target</small>
            </div>
        </div>
        <div class="card">
            <div class="card-head"><span>This Week's Breakdown</span></div>
            <p class="muted">Daily progress for the current week</p>
            @for (var i = 0; i < 7; i++)
            {
                var d = S.WeekStart.AddDays(i);
                var m = S.MinutesOn(d);
                <div class="mb-1.5 rounded-lg px-2.5 py-2 @(d == DateTime.Today ? "bg-tint" : "")">
                    <div class="flex items-center justify-between gap-3">
                        <span>@d.DayOfWeek @if (d == DateTime.Today) { <em class="ml-1.5 rounded-md bg-blue-500 px-1.5 py-px text-[10px] not-italic text-white">Today</em> }</span>
                        <small class="text-[11px] text-muted">@m min</small>
                    </div>
                    <ProgressBar Value="m" Max="S.User.DailyGoal" />
                </div>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-head"><span>Insights &amp; Recommendations</span></div>
        <div class="max-w-[340px] rounded-lg bg-tint px-3 py-2.5 text-xs text-blue-900">
            @(S.SessionCount == 0 ? "💡 Start your first study session today to build momentum!"
              : S.TodayMinutes >= S.User.DailyGoal ? "🎉 You hit today's goal. Nice work!"
              : $"💡 {S.User.DailyGoal - S.TodayMinutes} more minutes to reach today's goal.")
        </div>
    </div>
}

@code {
    bool editing; int newGoal;
    void StartEdit() { newGoal = S.User!.DailyGoal; editing = true; }
    void Save() { S.User!.DailyGoal = Math.Clamp(newGoal, 10, 600); S.Save(); editing = false; }
}
